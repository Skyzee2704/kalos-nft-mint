# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Private key of the minting wallet. Only via env — never print, log, or share it.
KALOS_PRIVATE_KEY=0x...
# Elysium testnet RPC. Alchemy recommended:
# https://elysium-testnet.g.alchemy.com/v2/<ALCHEMY_KEY>
# Public fallback: https://testnet-rpc.elysium.kinetiq.xyz
KALOS_RPC=https://elysium-testnet.g.alchemy.com/v2/<ALCHEMY_KEY>
# Wallet address used for eligibility checks in drop-scan.mjs.
# Optional — defaults to 0xE9973af1b69E407745926fA985C0090E0e78DcF1.
KALOS_WALLET_ADDRESS=0x...
